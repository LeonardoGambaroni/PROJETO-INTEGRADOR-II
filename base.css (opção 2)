body {
  font-family: Arial, sans-serif;
  background-color: #f0f0f0; /* fundo cinza claro */
  text-align: center; /* centraliza texto */
}

h2 {
  margin-top: 20px;
}

form {
  background: white;
  padding: 20px;
  margin: 20px auto;
  width: 300px;
  border: 1px solid #ccc;
  border-radius: 8px;
}

label {
  display: block;
  margin: 10px 0 5px;
  text-align: left;
}

input {
  width: 100%;
  padding: 8px;
  margin-bottom: 10px;
}

button {
  width: 100%;
  padding: 10px;
  background: blue;
  color: white;
  border: none;
  border-radius: 4px;
  cursor: pointer;
}

button:hover {
  background: darkblue;
}
