<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, 
  initial-scale=1.0"> <!--Ajuda no comportamento responsivo para dispositivos moveis--> 
  <title>Tela de Cadastro</title>
  <link rel="stylesheet" href="styles/base.css">
</head>
<body> 
  <div class="container">
    <h2>Cadastro</h2>
    <form action="cadastro.php" method="POST"> <!--Inicio do formulário action (indica para onde os dados vao ser enviados) method(envia os dados escondidos no corpo da requisição)-->
      <label for="nome">Nome</label>
      <input type="text" id="nome" name="nome" placeholder="Digite seu nome" autocomplete="name" required> <!--required serve para que nao seja possivel cadastrar sem o campo estar preenchido-->

      <label for="email">Email</label>
      <input type="email" id="email" name="email" placeholder="Digite seu email" autocomplete="email" required>

      <label for="senha">Senha</label>
      <input type="password" id="senha" name="senha" placeholder="Digite sua senha" autocomplete="new-password" required> <!--type="password" faz com que o texto digitado fique "escondido"--> 

      <label for="confirmar">Confirmar Senha</label>
      <input type="password" id="confirmar" name="confirmar" placeholder="Confirme sua senha" autocomplete="new-password" required>

      <button type="submit">Cadastrar</button>
    </form>
  </div>
</body>
</html>
